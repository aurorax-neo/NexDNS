FROM --platform=$BUILDPLATFORM alpine:3.21 AS sysdeps
RUN apk add --no-cache ca-certificates tzdata && \
    printf "Asia/Shanghai\n" > /tmp/timezone

FROM alpine:3.21
ARG TARGETARCH
WORKDIR /app
ENV TZ=Asia/Shanghai

COPY --from=sysdeps /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=sysdeps /usr/share/zoneinfo/Asia/Shanghai /etc/localtime
COPY --from=sysdeps /tmp/timezone /etc/timezone

# 直接注入宿主机交叉编译好的对应架构纯静态二进制并赋权
COPY --chmod=0755 docker-bin/${TARGETARCH}/nexdns /app/nexdns

EXPOSE 53/udp 53/tcp 3000/tcp 8053/tcp
ENTRYPOINT ["/app/nexdns"]
CMD ["--config", "/app/data/config.yaml"]
